    {
      "name": "3. Query-параметры",
      "item": [
        {
          "name": "GET Поиск",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks?search=отчёт",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "отчёт"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Найдены только подходящие\", function () { const d = pm.response.json(); pm.expect(d.items.every(t => t.title.toLowerCase().includes('отчёт'))).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Сортировка по приоритету",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks?sort=priority&order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "priority"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Первая задача с high\", function () { const d = pm.response.json(); pm.expect(d.items[0].priority).to.eql('high'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Пагинация",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks?page=1&limit=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Поля пагинации\", function () { const d = pm.response.json(); pm.expect(d.items.length).to.eql(3); pm.expect(d).to.include.keys('count', 'page', 'limit', 'totalPages'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Фильтр",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks?filter=done:false",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "done:false"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Только невыполненные\", function () { const d = pm.response.json(); pm.expect(d.items.every(t => t.done === false)).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Все параметры вместе",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks?filter=priority:high&sort=deadline&order=desc&page=1&limit=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "priority:high"
                },
                {
                  "key": "sort",
                  "value": "deadline"
                },
                {
                  "key": "order",
                  "value": "desc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Не больше двух задач high\", function () { const d = pm.response.json(); pm.expect(d.items.length).to.be.at.most(2); pm.expect(d.items.every(t => t.priority === 'high')).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    },
